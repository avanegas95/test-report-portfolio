---
interface Props {
  title?: string;
}

const { title = "The Test Report" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Anderson Vanegas — Staff SQA Engineer portfolio as a test report."
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
