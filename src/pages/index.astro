---
import { getCollection, getEntry, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SkipLink from "@components/chrome/SkipLink.astro";
import SiteNav from "@components/chrome/SiteNav.astro";
import Footer from "@components/chrome/Footer.astro";
import Summary from "@/sections/Summary.astro";
import Suites from "@/sections/Suites.astro";
import Environment from "@/sections/Environment.astro";
import Quality from "@/sections/Quality.astro";
import SignOff from "@/sections/SignOff.astro";
import type { SuiteValue } from "@/lib/content-schemas";
import { buildReportContext } from "@/lib/report";

const siteEntry = await getEntry("site", "site");
if (!siteEntry) {
  throw new Error("Site content entry not found.");
}

const suiteEntries = await getCollection("suites");
const report = buildReportContext({
  site: siteEntry.data,
  suites: suiteEntries.map(
    (entry: CollectionEntry<"suites">) => entry.data as SuiteValue,
  ),
});

const navSections = [
  { id: "summary", number: "01", label: "Summary" },
  { id: "suites", number: "02", label: "Suites" },
  { id: "environment", number: "03", label: "Environment" },
  { id: "quality", number: "04", label: "Quality" },
  { id: "signoff", number: "05", label: "Sign-off" },
];
---

<BaseLayout title={`Anderson Vanegas — Test Report ${report.version}`}>
  <SkipLink />
  <SiteNav
    version={report.version}
    sections={navSections}
    resumePdf={report.contact.resumePdf}
  />
  <main id="main" tabindex="-1">
    <Summary
      hero={report.hero}
      subjectCard={report.site.subjectCard}
      metrics={report.metrics}
      meta={report.meta}
    />
    <Suites
      section={report.site.suitesSection}
      suites={report.suites}
      totals={{
        total: report.totals.caseCount,
        passed: report.totals.passed,
        failed: report.totals.failed,
        skipped: report.totals.skipped,
      }}
    />
    <Environment
      section={report.site.environmentSection}
      tools={report.site.tools}
      testBeds={report.site.testBeds}
    />
    <Quality section={report.site.qualitySection} />
    <SignOff section={report.site.signoff} contact={report.contact} />
  </main>
  <Footer left={report.footerLeft} right={report.site.footer.right} />
</BaseLayout>
