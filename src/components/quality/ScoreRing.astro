---
import {
  scoreRingStatus,
  statusRingStrokeClass,
  statusRingTrackClass,
  statusTextClass,
} from "@/lib/status";

interface Props {
  score: number;
  label: string;
}

const { score, label } = Astro.props;

const status = scoreRingStatus(score);
const radius = 42;
const circumference = 2 * Math.PI * radius;
const progress = (score / 100) * circumference;
const ariaLabel = `${label}: ${score} out of 100`;
---

<div class="flex flex-col items-center gap-2.5">
  <div class="relative h-24 w-24" role="img" aria-label={ariaLabel}>
    <svg width="96" height="96" viewBox="0 0 96 96" aria-hidden="true">
      <circle
        cx="48"
        cy="48"
        r={radius}
        fill="none"
        stroke-width="6"
        class={statusRingTrackClass(status)}></circle>
      <circle
        cx="48"
        cy="48"
        r={radius}
        fill="none"
        stroke-width="6"
        stroke-linecap="round"
        stroke-dasharray={`${progress} ${circumference}`}
        transform="rotate(-90 48 48)"
        class={statusRingStrokeClass(status)}></circle>
    </svg>
    <span
      class:list={[
        "absolute inset-0 flex items-center justify-center font-mono text-[26px] font-medium",
        statusTextClass(status),
      ]}
    >
      {score}
    </span>
  </div>
  <span class="text-sm text-text-2">{label}</span>
</div>
