---
type IconName =
  | "check"
  | "chevron"
  | "chevron-down"
  | "chevron-right"
  | "arrow"
  | "arrow-right"
  | "download";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size, class: className = "" } = Astro.props;

const resolvedName =
  name === "arrow-right"
    ? "arrow"
    : name === "chevron-right" || name === "chevron-down"
      ? "chevron"
      : name;

const sizeClass = size ? undefined : "size-4";
const sizeStyle = size ? `width:${size}px;height:${size}px` : undefined;
const rotationClass =
  name === "chevron-right" ? "-rotate-90" : name === "chevron-down" ? "" : "";
---

{
  resolvedName === "check" && (
    <svg
      class:list={[sizeClass, className]}
      style={sizeStyle}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5" />
    </svg>
  )
}

{
  resolvedName === "chevron" && (
    <svg
      class:list={[sizeClass, rotationClass, className]}
      style={sizeStyle}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  )
}

{
  resolvedName === "arrow" && (
    <svg
      class:list={[sizeClass, className]}
      style={sizeStyle}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
  )
}

{
  resolvedName === "download" && (
    <svg
      class:list={[sizeClass, className]}
      style={sizeStyle}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
      <polyline points="7 10 12 15 17 10" />
      <line x1="12" x2="12" y1="15" y2="3" />
    </svg>
  )
}
