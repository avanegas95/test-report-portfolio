---
import Terminal from "./Terminal.astro";
import type { Status } from "@/lib/status";

interface Story {
  precondition: string;
  steps: string[];
  expected: string;
  actual: string;
  terminal?: Array<
    { cmd: string } | { line: string; result: string; status: Status }
  >;
  tags?: string[];
}

interface Props {
  story: Story;
  caseId: string;
}

const { story, caseId } = Astro.props;
const panelId = `story-${caseId}`;
---

<div
  id={panelId}
  role="region"
  aria-labelledby={`${caseId}-header`}
  class="grid gap-8 bg-info-surface px-5 pb-8 pt-2 md:grid-cols-[minmax(0,1fr)_380px] md:pl-[156px] md:pr-7"
>
  <div class="flex flex-col gap-5">
    <div class="flex flex-col gap-1.5">
      <span class="font-mono text-label uppercase tracking-label text-muted"
        >Precondition</span
      >
      <p class="text-[15px] leading-relaxed text-text-3">
        {story.precondition}
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <span class="font-mono text-label uppercase tracking-label text-muted"
        >Steps</span
      >
      <ol
        class="flex list-decimal flex-col gap-1.5 pl-5 text-[15px] leading-snug text-text-3"
      >
        {story.steps.map((step) => <li>{step}</li>)}
      </ol>
    </div>

    <div
      class="grid gap-5 border-t border-info-surface-border pt-4 md:grid-cols-2"
    >
      <div class="flex flex-col gap-1.5">
        <span class="font-mono text-label uppercase tracking-label text-muted"
          >Expected</span
        >
        <p class="text-[15px] leading-snug text-text-3">{story.expected}</p>
      </div>
      <div class="flex flex-col gap-1.5">
        <span class="font-mono text-label uppercase tracking-label text-pass"
          >Actual</span
        >
        <p class="text-[15px] leading-snug text-text-3">{story.actual}</p>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-3">
    {story.terminal && <Terminal lines={story.terminal} />}
    {
      story.tags && story.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {story.tags.map((tag) => (
            <span class="inline-flex rounded-sm border border-info-surface-border bg-paper px-2 py-1 font-mono text-xs text-text-2">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</div>
