---
interface Props {
  total: number;
  passed: number;
  failed: number;
  skipped: number;
}

const { total, passed, failed, skipped } = Astro.props;
---

<div class="flex flex-wrap gap-2 font-mono text-xs">
  <span class="rounded-sm border border-rule bg-paper px-2.5 py-1.5"
    >{total} run</span
  >
  <span class="rounded-sm bg-pass-bg px-2.5 py-1.5 font-semibold text-pass"
    >{passed} passed</span
  >
  <span class="rounded-sm border border-rule bg-paper px-2.5 py-1.5 text-muted"
    >{failed} failed</span
  >
  <span class="rounded-sm border border-rule bg-paper px-2.5 py-1.5 text-muted"
    >{skipped} skipped</span
  >
</div>
