---
interface MetaItem {
  key: string;
  value: string;
}

interface Props {
  items: MetaItem[];
}

const { items } = Astro.props;
---

<dl
  class="grid grid-cols-2 gap-x-6 gap-y-4 border-y border-ink py-3.5 font-mono text-xs md:grid-cols-4 md:gap-6"
>
  {
    items.map((item) => (
      <div class="flex flex-col gap-1">
        <dt class="tracking-label text-muted uppercase">{item.key}</dt>
        <dd class="text-ink">{item.value}</dd>
      </div>
    ))
  }
</dl>
