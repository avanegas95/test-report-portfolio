---
import type { Status } from "@/lib/status";
import { statusTextClass } from "@/lib/status";

interface Props {
  value: string;
  label: string;
  status?: Status;
  size?: "hero" | "tile";
}

const { value, label, status, size = "hero" } = Astro.props;

const valueSize =
  size === "hero"
    ? "text-metric-xl-m md:text-metric-xl"
    : "text-metric-tile leading-none";
---

<div
  class:list={[
    "flex flex-col gap-2",
    size === "hero" &&
      "border-r border-rule px-0 py-7 last:border-r-0 md:px-7 md:first:pl-0",
    size === "tile" && "gap-4",
  ]}
>
  <span
    class:list={[
      "font-mono tracking-[-0.02em]",
      valueSize,
      status ? statusTextClass(status) : "text-ink",
    ]}
  >
    {value}
  </span>
  <span class="text-sm text-text-2">{label}</span>
</div>
