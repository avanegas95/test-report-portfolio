---
interface Approval {
  key: string;
  value: string;
  placeholderStyle?: boolean;
}

interface Props {
  approvals: Approval[];
}

const { approvals } = Astro.props;
---

<div class="flex flex-col gap-4 rounded-xl border border-rule px-6 py-5">
  <span class="font-mono text-xs tracking-label text-muted uppercase"
    >Approvals</span
  >
  {
    approvals.map((item) => (
      <div class="grid grid-cols-[110px_minmax(0,1fr)] items-end gap-3">
        <span class="font-mono text-xs text-muted">{item.key}</span>
        <span
          class:list={[
            "pb-1.5 text-base",
            item.placeholderStyle
              ? "border-b border-dashed border-[#B8BDC6] font-mono text-sm text-faint"
              : "border-b border-ink",
          ]}
        >
          {item.value}
        </span>
      </div>
    ))
  }
</div>
