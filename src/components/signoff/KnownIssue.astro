---
import StatusBadge from "@components/primitives/StatusBadge.astro";
import type { Status } from "@/lib/status";

interface Props {
  id: string;
  status: Status;
  label: string;
  text: string;
}

const { id, status, label, text } = Astro.props;
---

<div
  class="flex flex-col gap-2 rounded-xl border border-warn-border bg-warn-surface px-5 py-4"
>
  <div class="flex items-center justify-between gap-3">
    <span class="font-mono text-xs font-semibold text-warn uppercase">
      Known issue · {id}
    </span>
    <StatusBadge status={status} label={label} />
  </div>
  <p class="text-sm leading-snug text-text-2">{text}</p>
</div>
