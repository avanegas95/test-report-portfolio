{
  "$description": "Design tokens for 'The Test Report' portfolio. Values are taken from the mockups in ../design/. Color is semantic only.",
  "color": {
    "ink": { "value": "#14161A", "use": "Primary text, primary buttons, top rule of report blocks" },
    "text-2": { "value": "#4A5160", "use": "Secondary text, body copy on white" },
    "text-3": { "value": "#2B3038", "use": "Body copy inside the expanded story panel" },
    "muted": { "value": "#636B78", "use": "Mono labels, eyebrows, captions (4.5:1+ on white; do not lighten)" },
    "faint": { "value": "#8A919C", "use": "Decorative only: title suffix, chevrons, nav numbers (large or non-essential text)" },
    "rule": { "value": "#E3E5E9", "use": "Section dividers, card borders" },
    "rule-soft": { "value": "#EDEEF1", "use": "Row dividers inside tables/cards" },
    "border-control": { "value": "#D5D8DE", "use": "Secondary button borders" },
    "paper": { "value": "#FFFFFF", "use": "Main background, cards" },
    "paper-alt": { "value": "#FAFAF8", "use": "Alternating section background, table header rows" },
    "chip-neutral": { "value": "#F0F1F3", "use": "Neutral chips (SUITE SN, test beds)" },

    "pass": { "fg": "#17693F", "bg": "#E6F4EC", "border": "#BFE3CD", "dot": "#1F8A52", "surface": "#F3FAF6", "surface-border": "#D5EDDF" },
    "warn": { "fg": "#8A5300", "bg": "#FDF2DB", "border": "#F3DDAF", "dot": "#D98A00", "surface": "#FFFBF2" },
    "fail": { "fg": "#B42318", "bg": "#FDECEA", "dot": "#D92D20" },
    "info": { "fg": "#1F55B8", "bg": "#E8EFFC", "dot": "#2F6BD8", "surface": "#F5F8FE", "surface-border": "#DCE5F5", "link-hover": "#153E87" }
  },
  "font": {
    "sans": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace",
    "weights": { "sans": [400, 500, 600, 700], "mono": [400, 500, 600] }
  },
  "type": {
    "desktop": {
      "h1": { "size": 64, "lineHeight": 1.04, "weight": 600, "tracking": "-0.025em" },
      "verdict": { "size": 30, "lineHeight": 1.3, "weight": 500, "tracking": "-0.01em" },
      "h2": { "size": 40, "lineHeight": 1.1, "weight": 600, "tracking": "-0.02em" },
      "h2-signoff": { "size": 48, "lineHeight": 1.08, "weight": 600 },
      "h3": { "size": 22, "weight": 600 },
      "lede": { "size": 17, "lineHeight": 1.6 },
      "body-lg": { "size": 18, "lineHeight": 1.6 },
      "row-title": { "size": 16, "weight": 500 },
      "metric-xl": { "size": 44, "family": "mono", "weight": 500 },
      "metric-tile": { "size": 48, "family": "mono", "weight": 500 },
      "eyebrow": { "size": 12, "family": "mono", "tracking": "0.1em", "case": "upper" },
      "label": { "size": 11, "family": "mono", "tracking": "0.08em", "case": "upper" }
    },
    "mobile": {
      "h1": { "size": 38, "lineHeight": 1.06 },
      "verdict": { "size": 23 },
      "h2": { "size": 30, "lineHeight": 1.12 },
      "row-title": { "size": 15 },
      "metric-xl": { "size": 34 }
    }
  },
  "badge": { "family": "mono", "size": 11, "weight": 600, "tracking": "0.06em", "paddingX": 9, "paddingY": 3, "radius": 999, "dot": 6 },
  "radius": { "sm": 6, "md": 8, "lg": 10, "xl": 12, "pill": 999 },
  "layout": {
    "desktop": { "frame": 1440, "content": 1120, "gutter": 160, "sectionPaddingY": 96, "navHeight": 72 },
    "mobile": { "frame": 390, "gutter": 16, "gutterText": 20, "navHeight": 60 },
    "touchTarget": 44,
    "buttonHeight": 48
  },
  "lighthouseThresholds": { "pass": 90, "warn": 50 }
}
